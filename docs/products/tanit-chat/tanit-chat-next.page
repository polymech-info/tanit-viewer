le\":\"Batch translate or transform\",\"text\":\"Run the same job across a folder of documents\"},{\"icon\":\"documents\",\"title\":\"Index and search\",\"text\":\"Find text inside Office files and PDFs\"},{\"icon\":\"images-raw\",\"title\":\"Convert to images\",\"text\":\"Export pages from any of those formats\"}]}]},{\"id\":\"video\",\"label\":\"Video\",\"icon\":\"video\",\"description\":\"Playback and inspect video, capture webcam or screen, batch convert formats. Session MP4 recording and xblox record blocks — user-started or user-authored scheduled flows only, never covert capture.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Play, capture, convert\",\"description\":\"Review clips in place, capture when you start it, convert in batch — same workspace as chat.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/chat-video-gen.jpg\"},\"highlights\":[{\"icon\":\"video\",\"title\":\"Playback & inspect\",\"text\":\"Scrub and review without leaving Chat\"},{\"icon\":\"rt-video\",\"title\":\"Webcam / screen capture\",\"text\":\"User-started only — Windows consent on first use\"},{\"icon\":\"command\",\"title\":\"Batch convert\",\"text\":\"FFmpeg, HandBrake, and other tools via commands\"},{\"icon\":\"video\",\"title\":\"Session recording\",\"text\":\"MP4 and xblox record blocks you author yourself\"}],\"actions\":[{\"label\":\"Get Tanit Chat — free\",\"primary\":true,\"href\":\"https://apps.microsoft.com/detail/9N5F39064NPD\"}]}]},{\"id\":\"browser-use\",\"label\":\"Browser Use\",\"icon\":\"html\",\"description\":\"Search, research, fill forms, translate, talk, summarize, create subtitles, and run Tanit workflows directly beside the web.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Open Tanit beside any page, publish browser work as articles\",\"description\":\"Search, read, fill, translate, and talk without leaving the page. A task can start in Chrome and finish in a local file or an XBlox flow.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/chrome.jpg\"},\"highlights\":[{\"icon\":\"html\",\"title\":\"Research without tab chaos\",\"text\":\"Search, open results, compare sources, and keep the useful parts together\"},{\"icon\":\"documents\",\"title\":\"Forms from files you have\",\"text\":\"Fill from a PDF, invoice, or spreadsheet. It stops when you need to decide\"},{\"icon\":\"audio\",\"title\":\"Translate, talk, subtitle\",\"text\":\"A page, a reply, or a video: transcript, subtitles, or a dubbed version\"},{\"icon\":\"command\",\"title\":\"Point, then finish the job\",\"text\":\"Use a chart, field, or paragraph. Save the result, or continue as a workflow\"}],\"actions\":[{\"label\":\"Read more\",\"primary\":true,\"href\":\"https://tanit.polymech.info/user/cgo/pages/tanit-chrome\"}]}]},{\"id\":\"share\",\"label\":\"Share\",\"icon\":\"cms\",\"description\":\"Create and share reports, articles, posts, pictures, and files directly from Tanit.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Create and share from Tanit\",\"description\":\"Publish a report, an article, a set of pictures, or a file. Tanit uploads it to your account and gives you a link you can send.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/cms.jpg\"},\"highlights\":[{\"icon\":\"markdown\",\"title\":\"Reports and articles\",\"text\":\"Any chat and becomes a page\"},{\"icon\":\"documents\",\"title\":\"Share files\",\"text\":\"PDFs, CAD, archives, and media from home/public, with a link to copy\"},{\"icon\":\"images-raw\",\"title\":\"Posts and pictures\",\"text\":\"A title and pictures, public, listed, or private\"},{\"icon\":\"command\",\"title\":\"App or command line\",\"text\":\"Sharing actions in the app, or tanit-cli service for pages, files, posts, and pictures\"}]}]},{\"id\":\"automation\",\"label\":\"Automation\",\"icon\":\"xblox\",\"description\":\"Capture the process as an XBlox flow — combine an LLM agent with file input, models, OCR, vision, audio, conditions, loops, and saved output. Publish it to the ribbon, launcher, Tanit, or the Windows Explorer context menu.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Turn a chat into a command\",\"description\":\"When the task repeats, save the successful process and run it on the next selection.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/automation.jpg\"},\"highlights\":[{\"icon\":\"xblox\",\"title\":\"Visual XBlox flows\",\"text\":\"Agent + files + models + conditions in one graph\",\"slide\":\"overview\"},{\"icon\":\"command\",\"title\":\"Publish anywhere\",\"text\":\"Ribbon, launcher, Tanit, or Explorer context menu\",\"slide\":\"launcher\"},{\"icon\":\"html\",\"title\":\"Browser-use flows\",\"text\":\"Drive a form or page from a saved command\",\"slide\":\"browser\"},{\"icon\":\"command\",\"title\":\"One-click recurring work\",\"text\":\"The next file runs the same reviewed process\",\"slide\":\"overview\"}]},{\"id\":\"launcher\",\"title\":\"Published in the launcher\",\"description\":\"A finished flow becomes a command you can run without opening the editor.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/launcher.jpg\"},\"highlights\":[]},{\"id\":\"browser\",\"title\":\"Browser-use from a command\",\"description\":\"Drive a page or form with the same flow that started as a chat.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/forms-browser-use.jpg\"},\"highlights\":[]}]},{\"id\":\"security\",\"label\":\"Security\",\"icon\":\"command\",\"description\":\"Tanit Chat is a secure and OWASP compliant AI assistant that meets the highest security standards.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Approve every action\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/security.jpg\"},\"highlights\":[{\"icon\":\"command\",\"title\":\"Complete GPO Support\",\"text\":\"Lockdown providers,models and interface\"},{\"icon\":\"command\",\"title\":\"Security Agent\",\"text\":\"Once, task, session, limited time, always, or never\"}],\"actions\":[{\"label\":\"Read more\",\"primary\":true,\"href\":\"https://tanit.polymech.info/user/cgo/pages/tanit-security\"}]}]},{\"id\":\"files\",\"label\":\"Files\",\"icon\":\"documents\",\"description\":\"Browse local and remote files, move data between devices, search large folder trees, see what is taking up disk space, and let Tanit work directly with the files in front of you.\",\"slides\":[{\"id\":\"overview\",\"title\":\"The file panel beside the viewer\",\"description\":\"Open a folder on this PC, connect a phone, browse SSH or FTP, preview files, copy between locations, or switch to a disk-usage view.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/filemanager.jpg\"},\"highlights\":[{\"icon\":\"images-raw\",\"title\":\"Icons, tiles, previews\",\"text\":\"Complete keyboard support and fast folder size calculation\"},{\"icon\":\"network\",\"title\":\"SSH, FTP, MTP\",\"text\":\"Native file manager & custom commands for batch operations\"}],\"actions\":[{\"label\":\"Read more\",\"primary\":true,\"href\":\"https://tanit.polymech.info/user/3bb4cfbf-318b-44d3-a9d3-35680e738421/pages/feature-files\"}]}]}]}</script>\n<script type=\"application/json\" id=\"icons\">{\"audio\":\"\\u003csvg viewBox=\\\"0 0 64 64\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2.5\\\" stroke-linecap=\\\"round\\\" aria-hidden=\\\"true\\\">\\u003cpath d=\\\"M14 32v0M20 24v16M26 18v28M32 22v20M38 16v32M44 24v16M50 30v4\\\"/>\\u003c/svg>\",\"avatar\":\"\\u003csvg viewBox=\\\"0 0 64 64\\\" fill=\\\"none\\\" aria-hidden=\\\"true\\\">\\n  \\u003ccircle cx=\\\"32\\\" cy=\\\"14\\\" r=\\\"5.8\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2.8\\\"/>\\n  \\u003cpath d=\\\"M32 21.5c-5.2 5.8-9.8 13.2-11.2 21.2 4.6-1.4 7.8-1.8 11.2-1.8s6.6.4 11.2 1.8C41.8 34.7 37.2 27.3 32 21.5z\\\" fill=\\\"currentColor\\\"/>\\n  \\u003cpath d=\\\"M24.5 29c-4.2-2.8-7.6-7.2-8.4-12.8\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2.8\\\" stroke-linecap=\\\"round\\\"/>\\n  \\u003cpath d=\\\"M39.5 29c4.2-2.8 7.6-7.2 8.4-12.8\\\" stroke=\\\"currentColor\\\" stroke-width