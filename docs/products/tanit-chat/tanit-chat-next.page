3,.12);\r\n}\r\n.tv-explore[data-skin=\"shell\"][data-theme=\"dark\"]{\r\n  color-scheme:dark;\r\n  --bg:var(--tv-bg-dark); --ink:#ece8df; --muted:#a7a299; --dim:#a7a299;\r\n  --accent:#c8362b; --accent-hover:#e8635a;\r\n  --accent-soft:rgba(200,54,43,.16);\r\n  --amber:#e8635a;\r\n  --panel:#1c1b16; --panel-2:#14130f;\r\n  --line:#3a3830; --line-strong:#5a564c;\r\n  --media:var(--tv-bg-dark);\r\n  --shadow:0 1px 2px rgba(0,0,0,.28);\r\n  --shadow-lg:0 1px 2px rgba(0,0,0,.28),0 10px 28px rgba(0,0,0,.32);\r\n  --sel-bg:rgba(200,54,43,.16);\r\n  --lb-scrim:color-mix(in srgb,var(--tv-bg-dark) 92%,transparent);\r\n  --lb-card:rgba(28,27,22,.88);\r\n  --lb-line:#3a3830;\r\n  --lb-ink:#ece8df;\r\n  --lb-muted:#a7a299;\r\n  --lb-dim:rgba(236,232,223,.55);\r\n  --lb-btn:rgba(28,27,22,.88);\r\n  --lb-btn-hover:#1c1b16;\r\n  --lb-shadow:0 10px 32px rgba(0,0,0,.4);\r\n}\r\n\r\n</style>\r\n<div class=\"shell\">\r\n  <aside class=\"sidebar\">\r\n    <button type=\"button\" class=\"menu-btn\" id=\"menuBtn\" aria-label=\"Features\" aria-expanded=\"false\" aria-controls=\"sideNav\">\r\n      <svg class=\"ico-menu\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></svg>\r\n      <svg class=\"ico-close\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>\r\n    </button>\r\n    <button type=\"button\" class=\"side-brand\" id=\"brandBtn\">\r\n      <div class=\"side-logo\" id=\"brandLogo\"></div>\r\n      <strong id=\"brandTitle\"></strong>\r\n    </button>\r\n    <div class=\"top-tour\" id=\"topTour\"></div>\r\n    <nav class=\"side-nav\" id=\"sideNav\" aria-label=\"Features\"></nav>\r\n    <div class=\"side-foot\">\r\n      <button type=\"button\" class=\"layout-btn\" id=\"layoutBtn\" aria-label=\"Continuous scroll\" title=\"Scroll\" aria-pressed=\"false\">\r\n        <svg class=\"ico-scroll\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M5 5h14M5 10h14M5 15h14M5 20h10\"/></svg>\r\n        <svg class=\"ico-classic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"7\" height=\"16\" rx=\"1.5\"/><rect x=\"13\" y=\"4\" width=\"8\" height=\"16\" rx=\"1.5\"/></svg>\r\n      </button>\r\n      <button type=\"button\" class=\"theme-btn\" id=\"themeBtn\" aria-label=\"Toggle theme\" title=\"Theme\">\r\n        <span class=\"moon\" aria-hidden=\"true\">◐</span>\r\n        <span class=\"sun\" aria-hidden=\"true\">☀</span>\r\n      </button>\r\n    </div>\r\n  </aside>\r\n  <div class=\"nav-backdrop\" id=\"navBackdrop\" hidden></div>\r\n  <div class=\"main\">\r\n    <section class=\"stage\" id=\"stage\" aria-live=\"polite\"></section>\r\n  </div>\r\n</div>\r\n<script type=\"application/json\" id=\"data\">{\"product\":{\"title\":\"Tanit Chat\",\"subtitle\":\"Many tools. One workspace. Local first.\",\"tip\":\"Select files in Tanit or Explorer — they become the chat context.\",\"features\":[{\"id\":\"ai\",\"label\":\"AI\",\"icon\":\"command\",\"description\":\"Connect direct providers, bring your own key, use compatible endpoints, choose an aggregator, or run supported models locally with llama.cpp. Switch models as your needs change.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Route each capability to the right model\",\"description\":\"Text, planning, vision, OCR, image generation, transcription, and speech each use a different local or cloud provider — never one vendor for everything.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/chat.jpg\"},\"highlights\":[{\"icon\":\"command\",\"title\":\"Local llama.cpp + GGUF\",\"text\":\"Run supported models on-device\"},{\"icon\":\"network\",\"title\":\"Cloud & BYOK\",\"text\":\"Direct providers, compatible endpoints, aggregators\"},{\"icon\":\"command\",\"title\":\"Per-capability routing\",\"text\":\"Pick a model per job, not per app\"},{\"icon\":\"command\",\"title\":\"Save a full agent as a preset\",\"text\":\"Provider, tools, skills, and MCP in one reusable setup\"}],\"actions\":[{\"label\":\"Read more\",\"primary\":true,\"href\":\"https://tanit.polymech.info/user/3bb4cfbf-318b-44d3-a9d3-35680e738421/pages/tanit-chat\"}]}]},{\"id\":\"voice\",\"label\":\"Voice\",\"icon\":\"audio\",\"description\":\"Transcribe recordings and voice input offline with whisper.cpp. Local speech synthesis can read responses without sending them to a cloud voice provider.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Talk instead of typing\",\"description\":\"Voice is a local capability first. Cloud realtime routing is opt-in when you want it.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/audio.jpg\"},\"highlights\":[{\"icon\":\"audio\",\"title\":\"whisper.cpp offline\",\"text\":\"Transcribe recordings and voice input on-device\"},{\"icon\":\"rt-audio\",\"title\":\"Local speech synthesis\",\"text\":\"Read answers without a cloud voice provider\"},{\"icon\":\"rt-audio\",\"title\":\"Realtime voice routing\",\"text\":\"Opt in when a live session is worth it\"},{\"icon\":\"command\",\"title\":\"Voice commands\",\"text\":\"Hands-free control of the workspace\"}],\"actions\":[{\"label\":\"Read more\",\"primary\":true,\"href\":\"https://tanit.polymech.info/user/cgo/pages/tanit-audio\"}]}]},{\"id\":\"images\",\"label\":\"Images\",\"icon\":\"images-raw\",\"description\":\"Browse and inspect images, transform media, work with metadata. Use local vision-language models for private image understanding, ONNX for OCR and layout, or route image generation to a cloud provider.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Inspect, batch, generate\",\"_description\":\"Vision can stay on the device. Generation can go to the cloud. You choose per job.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/image-ops.jpg\"},\"highlights\":[{\"icon\":\"images-raw\",\"title\":\"Batch create, resize, convert and transform\",\"text\":\"Fully customizable workflows using visual automation and batch operations.\"},{\"icon\":\"images-raw\",\"title\":\"Duplicate finder and junk finder\",\"text\":\"Group near-duplicates by fingerprint and remove junk image removale\"},{\"icon\":\"images-raw\",\"title\":\"Image vision & OCR\",\"text\":\"Ask what is in a photo, or read the text with OCR\"},{\"icon\":\"command\",\"title\":\"Complete CLI\",\"text\":\"find, duplicates, resize, compress, create, transform, and understand\"},{\"icon\":\"images-raw\",\"title\":\"Advanced screenshots\",\"text\":\"Integrated screenshot taking, monitor, fullscreen, window or a picked region\"},{\"icon\":\"network\",\"title\":\"Share as posts\",\"text\":\"Share images as posts or articles\"}]}]},{\"id\":\"3d\",\"icon\":\"cad\",\"label\":\"3D\",\"_description\":\"Preview common meshes & CAD\",\"slides\":[{\"id\":\"overview\",\"title\":\"Blazing fast 3D preview, opens 40MB STEP in less than 2 seconds\",\"description\":\"Supports STEP, STL, FBX, VTK, USD, DXF, FreeCAD, OBJ, GLTF, GLB, and OpenSCAD\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/3d.jpg\"},\"highlights\":[{\"icon\":\"command\",\"title\":\"Custom commands\",\"text\":\"Build your own optimized workflows using XBLOX and batch operations.\"}]}]},{\"id\":\"office\",\"label\":\"Office\",\"icon\":\"documents\",\"description\":\"Create and edit Word, Excel, PowerPoint, and PDF. Batch translate and create\",\"slides\":[{\"id\":\"overview\",\"title\":\"Office and PDF\",\"description\":\"Open a spreadsheet or a deck without a separate office suite.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/office-docs.jpg\"},\"highlights\":[{\"icon\":\"documents\",\"title\":\"Built-in viewer\",\"text\":\"Word, Excel, PowerPoint, and PDF in the centre pane\"},{\"icon\":\"command\",\"title\":\"Batch translate or transform\",\"text\":\"Run the same job across a folder of documents\"},{\"icon\":\"documents\",\"title\":\"Index and search\",\"text\":\"Find text inside Office files and PDFs\"},{\"icon\":\"images-raw\",\"title\":\"Convert to images\",\"text\":\"Export pages from any of those formats\"}]}]},{\"id\":\"video\",\"label\":\"Video\",\"icon\":\"video\",\"description\":\"Playback and inspect video, capture webcam or screen, batch convert formats. Session MP4 recording and xblox record blocks — user-started or user-authored scheduled flows only, never covert capture.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Play, capture, convert\",\"description\":\"Review clips in place, capture when you start it, convert in batch — same workspace as chat.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/chat-video-gen.jpg\"},\"highlights\":[{\"icon\":\"video\",\"title\":\"Playback & inspect\",\"text\":\"Scrub and review without leaving Chat\"},{\"icon\":\"rt-video\",\"title\":\"Webcam / screen capture\",\"text\":\"User-started only — Windows consent on first use\"},{\"icon\":\"command\",\"title\":\"Batch convert\",\"text\":\"FFmpeg, HandBrake, and other tools via commands\"},{\"icon\":\"video\",\"title\":\"Session recording\",\"text\":\"MP4 and xblox record blocks you author yourself\"}],\"actions\":[{\"label\":\"Get Tanit Chat — free\",\"primary\":true,\"href\":\"https://apps.microsoft.com/detail/9N5F39064NPD\"}]}]},{\"id\":\"browser-use\",\"label\":\"Browser Use\",\"icon\":\"html\",\"description\":\"Search, research, fill forms, translate, talk, summarize, create subtitles, and run Tanit workflows directly beside the web.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Open Tanit beside any page, publish browser work as articles\",\"description\":\"Search, read, fill, translate, and talk without leaving the page. A task can start in Chrome and finish in a local file or an XBlox flow.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/chrome.jpg\"},\"highlights\":[{\"icon\":\"html\",\"title\":\"Research without tab chaos\",\"text\":\"Search, open results, compare sources, and keep the useful parts together\"},{\"icon\":\"documents\",\"title\":\"Forms from files you have\",\"text\":\"Fill from a PDF, invoice, or spreadsheet. It stops when you need to decide\"},{\"icon\":\"audio\",\"title\":\"Translate, talk, subtitle\",\"text\":\"A page, a reply, or a video: transcript, subtitles, or a dubbed version\"},{\"icon\":\"command\",\"title\":\"Point, then finish the job\",\"text\":\"Use a chart, field, or paragraph. Save the result, or continue as a workflow\"}],\"actions\":[{\"label\":\"Read more\",\"primary\":true,\"href\":\"https://tanit.polymech.info/user/cgo/pages/tanit-chrome\"}]}]},{\"id\":\"share\",\"label\":\"Share\",\"icon\":\"cms\",\"description\":\"Create and share reports, articles, posts, pictures, and files directly from Tanit.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Create and share from Tanit\",\"description\":\"Publish a report, an article, a set of pictures, or a file. Tanit uploads it to your account and gives you a link you can send.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/cms.jpg\"},\"highlights\":[{\"icon\":\"markdown\",\"title\":\"Reports and articles\",\"text\":\"Any chat and becomes a page\"},{\"icon\":\"documents\",\"title\":\"Share files\",\"text\":\"PDFs, CAD, archives, and media from home/public, with a link to copy\"},{\"icon\":\"images-raw\",\"title\":\"Posts and pictures\",\"text\":\"A title and pictures, public, listed, or private\"},{\"icon\":\"command\",\"title\":\"App or command line\",\"text\":\"Sharing actions in the app, or tanit-cli service for pages, files, posts, and pictures\"}]}]},{\"id\":\"automation\",\"label\":\"Automation\",\"icon\":\"xblox\",\"description\":\"Capture the process as an XBlox flow — combine an LLM agent with file input, models, OCR, vision, audio, conditions, loops, and saved output. Publish it to the ribbon, launcher, Tanit, or the Windows Explorer context menu.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Turn a chat into a command\",\"description\":\"When the task repeats, save the successful process and run it on the next selection.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/automation.jpg\"},\"highlights\":[{\"icon\":\"xblox\",\"title\":\"Visual XBlox flows\",\"text\":\"Agent + files + models + conditions in one graph\",\"slide\":\"overview\"},{\"icon\":\"command\",\"title\":\"Publish anywhere\",\"text\":\"Ribbon, launcher, Tanit, or Explorer context menu\",\"slide\":\"launcher\"},{\"icon\":\"html\",\"title\":\"Browser-use flows\",\"text\":\"Drive a form or page from a saved command\",\"slide\":\"browser\"},{\"icon\":\"command\",\"title\":\"One-click recurring work\",\"text\":\"The next file runs the same reviewed process\",\"slide\":\"overview\"}]},{\"id\":\"launcher\",\"title\":\"Published in the launcher\",\"description\":\"A finished flow becomes a command you can run without opening the editor.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/launcher.jpg\"}},{\"id\":\"browser\",\"title\":\"Browser-use from a command\",\"description\":\"Drive a page or form with the same flow that started as a chat.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/forms-browser-use.jpg\"}}]},{\"id\":\"security\",\"label\":\"Security\",\"icon\":\"command\",\"description\":\"Tanit Chat is a secure and OWASP compliant AI assistant that meets the highest security standards.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Approve every action\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/security.jpg\"},\"highlights\":[{\"icon\":\"command\",\"title\":\"Complete GPO Support\",\"text\":\"Lockdown providers,models and interface\"},{\"icon\":\"command\",\"title\":\"Security Agent\",\"text\":\"Once, task, session, limited time, always, or never\"}],\"actions\":[{\"label\":\"Read more\",\"primary\":true,\"href\":\"https://tanit.polymech.info/user/cgo/pages/tanit-security\"}]}]},{\"id\":\"files\",\"label\":\"Files\",\"icon\":\"documents\",\"description\":\"Browse local and remote files, move data between devices, search large folder trees, see what is taking up disk space, and let Tanit work directly with the files in front of you.\",\"slides\":[{\"id\":\"overview\",\"title\":\"The file panel beside the viewer\",\"description\":\"Open a folder on this PC, connect a phone, browse SSH or FTP, preview files, copy between locations, or switch to a disk-usage view.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/filemanager.jpg\"},\"highlights\":[{\"icon\":\"images-raw\",\"title\":\"Icons, tiles, previews\",\"text\":\"Complete keyboard support and fast folder size calculation\"},{\"icon\":\"network\",\"title\":\"SSH, FTP, MTP\",\"text\":\"Native file manager & custom commands for batch operations\"}],\"actions\":[{\"label\":\"Read more\",\"primary\":true,\"href\":\"https://tanit.polymech.info/user/3bb4cfbf-318b-44d3-a9d3-35680e738421/pages/feature-files\"}]}]}],\"lang\":\"en\",\"intro\":{\"html\":\"\\u003ch1>Tanit Chat\\u003c/h1>\\n\\u003cp>Many tools. One workspace. Local first.\\u003c/p>\\n\\u003cp>Select files in Tanit or Explorer — they become the chat context.\\u003c/p>\\n\",\"label\":\"Intro\",\"file\":\"intro.md\"}},\"features\":[{\"id\":\"ai\",\"label\":\"AI\",\"icon\":\"command\",\"description\":\"Connect direct providers, bring your own key, use compatible endpoints, choose an aggregator, or run supported models locally with llama.cpp. Switch models as your needs change.\",\"slides\":[{\"id\":\"overview\",\"title\":\"Route each capability to the right model\",\"description\":\"Text, planning, vision, OCR, image generation, transcription, and speech each use a different local or cloud provider — never one vendor for everything.\",\"media\":{\"type\":\"image\",\"src\":\"./screenshots/chat.jpg\"},\"highlights\":[{\"icon\":\"command\",\"title\":\"Local llama.cpp + GGUF\",\"text\":\"Run supported models on-device\"},{\"icon\":\"network\",\"title\":\"C