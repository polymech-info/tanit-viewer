2px;\r\n  }\r\n}\r\n.hl{\r\n  position:relative;display:flex;align-items:flex-start;gap:12px;\r\n  width:100%;min-width:0;max-width:100%;box-sizing:border-box;\r\n  padding:12px 10px;border-radius:0;text-align:left;color:var(--ink);\r\n  border:0;border-left:2px solid transparent;background:transparent;\r\n  cursor:pointer;\r\n  transition:color .12s,background .12s,border-color .12s;\r\n}\r\n.hl:hover{background:var(--panel-2)}\r\n.hl[aria-current=\"true\"]{\r\n  color:var(--ink);background:transparent;\r\n  border-left-color:var(--accent);\r\n}\r\n.hl[aria-current=\"true\"] strong{color:var(--accent)}\r\n.hl-ico{\r\n  flex:0 0 32px;width:32px;height:32px;min-width:32px;max-width:32px;\r\n  aspect-ratio:1;border-radius:8px;margin-top:1px;box-sizing:border-box;\r\n  border:1px solid var(--line);background:var(--panel-2);\r\n  display:grid;place-items:center;padding:6px;color:var(--muted);\r\n  overflow:hidden;pointer-events:none;\r\n}\r\n.hl[aria-current=\"true\"] .hl-ico{color:var(--accent);border-color:color-mix(in srgb,var(--accent) 35%,var(--line))}\r\n.hl-ico svg{width:18px;height:18px;display:block;flex:none}\r\n.hl-body{min-width:0;flex:1 1 auto;text-align:left}\r\n.hl-body strong{display:block;font-size:.88rem;font-weight:600;margin-bottom:3px;letter-spacing:-.015em;color:inherit}\r\n.hl-body span{display:block;font-size:.78rem;line-height:1.45;color:var(--muted)}\r\n/* Quiet toolbar under media — content-sized, never full-bleed */\r\n.media-ctas{\r\n  display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-start;\r\n  gap:8px;padding:10px 16px 12px;flex-shrink:0;\r\n  border-top:1px solid var(--line);\r\n  background:var(--panel);\r\n}\r\n.media-ctas .actions{\r\n  display:flex;flex-wrap:wrap;align-items:center;gap:8px;\r\n  width:auto;max-width:100%;margin:0;padding:0;\r\n}\r\n.media-ctas .btn,\r\n.media-ctas a.btn{\r\n  display:inline-flex;align-items:center;justify-content:center;\r\n  flex:0 0 auto;width:auto;max-width:100%;min-width:0;\r\n  height:32px;padding:0 12px;box-sizing:border-box;\r\n  border-radius:8px;border:1px solid transparent;\r\n  font-size:.76rem;font-weight:600;letter-spacing:-.01em;\r\n  line-height:1;white-space:nowrap;text-decoration:none;\r\n  transition:background .12s,border-color .12s,color .12s,transform .08s;\r\n}\r\n.media-ctas .btn:active,\r\n.media-ctas a.btn:active{transform:translateY(1px)}\r\n.media-ctas .btn-primary{\r\n  background:var(--accent);color:#fff;border-color:transparent;\r\n}\r\n.media-ctas .btn-primary:hover{background:var(--accent-hover);color:#fff}\r\n.media-ctas .btn-ghost{\r\n  background:transparent;color:var(--ink);border-color:var(--line-strong);\r\n}\r\n.media-ctas .btn-ghost:hover{\r\n  border-color:color-mix(in srgb,var(--accent) 40%,var(--line));\r\n  color:var(--accent);background:var(--sel-bg);\r\n}\r\n\r\n.stage-media{\r\n  position:relative;flex:1 1 auto;min-height:220px;\r\n  display:flex;align-items:center;justify-content:center;overflow:visible;\r\n  /* Allow host-page scroll/pan; only lock gestures when zoomed */\r\n  padding:16px 20px;touch-action:pan-y pinch-zoom;user-select:none;background:var(--media);\r\n}\r\n.stage-media[data-zoomed]{cursor:grab;touch-action:none;overflow:hidden}\r\n.stage-media[data-panning]{cursor:grabbing}\r\n.media-surface{\r\n  position:relative;flex:1;width:100%;height:auto;min-width:0;min-height:0;\r\n  display:flex;align-items:center;justify-content:center;overflow:visible;\r\n  margin:0;box-sizing:border-box;\r\n}\r\n/* Classic: contain-fit. Keep overflow visible so the screenshot's own\r\n   window chrome (bottom 1px) is not clipped by subpixel rounding. */\r\n.stage:not(.is-stack) .stage-media{overflow:hidden}\r\n.stage:not(.is-stack) .media-surface,\r\n.stage:not(.is-stack) .media-xform{\r\n  height:100%;max-height:100%;min-height:0;overflow:visible;\r\n}\r\n.stage:not(.is-stack) .stage-media[data-zoomed],\r\n.stage:not(.is-stack) .stage-media[data-zoomed] .media-surface,\r\n.stage:not(.is-stack) .stage-media[data-zoomed] .media-xform{\r\n  overflow:hidden;\r\n}\r\n.stage:not(.is-stack) .stage-media img.media-el,\r\n.stage:not(.is-stack) .stage-media video.media-el{\r\n  width:auto;height:auto;max-width:100%;max-height:100%;\r\n  border-radius:0;\r\n}\r\n/* Zoom pans via translate3d only — never CSS scale (bilinear softens UI text) */\r\n.media-xform{\r\n  box-sizing:border-box;\r\n  flex:1 1 auto;\r\n  width:100%;height:100%;\r\n  min-width:0;min-height:0;\r\n  max-width:100%;max-height:100%;\r\n  display:flex;align-items:center;justify-content:center;\r\n  transform-origin:0 0;\r\n  will-change:auto;\r\n}\r\n.stage-media img.media-el,.stage-media video.media-el{\r\n  display:block;box-sizing:border-box;flex:none;\r\n  width:100%;height:auto;\r\n  max-width:100%;max-height:none;\r\n  object-fit:contain;object-position:center;\r\n  border-radius:0;\r\n  image-rendering:auto;\r\n  -webkit-user-drag:none;user-drag:none;\r\n  pointer-events:auto;\r\n}\r\n.stage-media[data-zoomed] img.media-el,\r\n.stage-media[data-zoomed] video.media-el{\r\n  max-width:none;max-height:none;\r\n}\r\n.stage-media .empty-media{color:var(--dim);font-size:.9rem;padding:24px;text-align:center}\r\n.zoom-badge{\r\n  position:absolute;right:14px;bottom:14px;z-index:2;\r\n  padding:4px 8px;border-radius:8px;font-size:.68rem;font-weight:600;\r\n  letter-spacing:-.01em;color:var(--ink);background:var(--panel);\r\n  border:1px solid var(--line);opacity:0;pointer-events:none;\r\n  transition:opacity .15s;\r\n}\r\n.stage-media[data-zoomed] .zoom-badge{opacity:1}\r\n\r\n.metrics{\r\n  display:grid;grid-template-columns:repeat(4,1fr);gap:8px;\r\n  padding:10px 14px;border-top:1px solid var(--line);background:var(--panel-2);\r\n}\r\n.metric{\r\n  padding:8px 10px;border-radius:8px;border:1px solid var(--line);\r\n  background:var(--panel);\r\n}\r\n.metric b{display:block;font-size:.76rem;font-weight:600;letter-spacing:-.015em;margin-bottom:2px;color:var(--ink)}\r\n.metric span{font-size:.66rem;color:var(--muted)}\r\n\r\n.stage-foot{\r\n  display:flex;align-items:center;justify-content:space-between;gap:14px;\r\n  flex-shrink:0;flex-wrap:wrap;\r\n  padding:8px 14px;border-top:1px solid var(--line);background:var(--panel);\r\n  z-index:3;\r\n}\r\n.tour-controls{\r\n  display:flex;flex-direction:row;align-items:center;gap:10px;\r\n  padding:5px 10px 5px 6px;border-radius:10px;border:1px solid var(--line);\r\n  background:var(--panel-2);flex-shrink:0;\r\n}\r\n.tour-controls[data-mode=\"playing\"]{border-color:color-mix(in srgb,var(--accent) 35%,var(--line))}\r\n.tour-controls[data-mode=\"paused\"]{border-color:color-mix(in srgb,var(--amber) 40%,var(--line))}\r\n.tour-controls[data-mode=\"stopped\"]{opacity:.92}\r\n.tour-btns{display:flex;gap:4px;flex-shrink:0}\r\n.tour-btn{\r\n  width:30px;height:30px;border-radius:8px;display:grid;place-items:center;\r\n  border:1px solid var(--line);background:var(--panel);color:var(--muted);\r\n  transition:color .12s,border-color .12s,background .12s;\r\n}\r\n.tour-btn:hover{color:var(--accent);border-color:color-mix(in srgb,var(--accent) 40%,var(--line))}\r\n.tour-btn[aria-pressed=\"true\"]{\r\n  color:#fff;background:var(--accent);border-color:transparent;\r\n}\r\n/* Stop must not use --ink fill (light on dark → white tile) */\r\n.tour-btn[data-act=\"stop\"][aria-pressed=\"true\"]{\r\n  color:var(--ink);\r\n  background:var(--sel-bg);\r\n  border-color:color-mix(in srgb,var(--accent) 28%,var(--line));\r\n}\r\n.tour-btn svg{width:14px;height:14px}\r\n.tour-meta{display:flex;flex-direction:column;align-items:flex-start;gap:1px;text-align:left;min-width:0}\r\n.tour-meta b{\r\n  font-size:.68rem;font-weight:600;letter-spacing:-.01em;color:var(--ink);\r\n}\r\n.tour-controls[data-mode=\"playing\"] .tour-meta b{color:var(--accent)}\r\n.tour-controls[data-mode=\"paused\"] .tour-meta b{color:var(--amber)}\r\n.tour-meta span{font-size:.65rem;color:var(--muted);line-height:1.25;white-space:nowrap;max-width:22ch;overflow:hidden;text-over