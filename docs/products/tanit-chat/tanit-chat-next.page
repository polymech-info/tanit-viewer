ne ~400px). Scroll inside; do not use 100dvh. */\r\n.tv-explore[data-pm-embed],.tv-explore[data-pm-embed] .tv-explore{\r\n  height:100%!important;min-height:0!important;overflow:hidden!important;\r\n}\r\n.tv-explore[data-pm-embed]{\r\n  height:100%!important;min-height:0!important;max-height:100%!important;\r\n  overflow:auto!important;\r\n}\r\n/* Standalone iframe: shell is the scroller. Inline .tv-explore: widget scrolls. */\r\n.tv-explore[data-pm-embed] .shell{\r\n  height:100%!important;min-height:0!important;max-height:none!important;\r\n  overflow:auto!important;\r\n}\r\n.tv-explore[data-pm-embed] .shell{\r\n  height:auto!important;min-height:100%!important;max-height:none!important;\r\n  overflow:visible!important;\r\n}\r\n.tv-explore[data-pm-embed] .sidebar,\r\n.tv-explore[data-pm-embed] .sidebar{\r\n  max-height:100%;\r\n}\r\n/* Inline embed (HtmlWidget): the host page scrolls. Pin the nav under the site header. */\r\n@media(min-width:901px){\r\n  .tv-explore[data-pm-embed]{\r\n    height:auto!important;max-height:none!important;overflow:visible!important;\r\n  }\r\n  .tv-explore[data-pm-embed] .shell{\r\n    height:auto!important;min-height:0!important;overflow:visible!important;\r\n    align-items:start;\r\n  }\r\n  .tv-explore[data-pm-embed] .main,\r\n  .tv-explore[data-pm-embed] .stage,\r\n  .tv-explore[data-pm-embed] .stage.is-stack,\r\n  .tv-explore[data-pm-embed] .stage-body,\r\n  .tv-explore[data-pm-embed] .stage-main{\r\n    height:auto;min-height:0;flex:none;overflow:visible;\r\n  }\r\n  .tv-explore[data-pm-embed] .sidebar{\r\n    position:sticky!important;top:3.5rem!important;z-index:4;align-self:start!important;\r\n    height:auto!important;max-height:calc(100svh - 3.5rem - 12px)!important;overflow:hidden;\r\n  }\r\n  .tv-explore[data-pm-embed] .side-nav{min-height:0}\r\n}\r\n.tv-explore[data-pm-embed] .stage-media,\r\n.tv-explore[data-pm-embed] .stage-media{min-height:160px}.tv-explore button,.tv-explore input{font:inherit;color:inherit}.tv-explore button{cursor:pointer;border:none;background:none}.tv-explore img,.tv-explore video{display:block;max-width:100%}.tv-explore a{color:inherit;text-decoration:none}\r\n@media (prefers-reduced-motion:reduce){.tv-explore *,.tv-explore *::before,.tv-explore *::after{animation:none!important;transition:none!important}}\r\n\r\n.shell{\r\n  display:grid;grid-template-columns:var(--side-w) minmax(0,1fr);\r\n  height:100%;min-height:0;gap:12px;padding:12px;\r\n}\r\n\r\n/* ── sidebar ── */\r\n.sidebar{\r\n  display:flex;flex-direction:column;min-height:0;border-radius:var(--radius);\r\n  background:var(--panel);border:1px solid var(--line);\r\n  box-shadow:var(--shadow);\r\n}\r\n.side-brand{display:flex;align-items:center;gap:12px;padding:16px 14px 12px;width:100%;text-align:left;min-width:0}\r\n.side-brand[aria-current=\"true\"] strong{color:var(--accent)}\r\n.menu-btn,.top-tour{display:none}\r\n.menu-btn{\r\n  width:34px;height:34px;border-radius:10px;place-items:center;\r\n  border:1px solid var(--line);background:var(--panel-2);color:var(--muted);\r\n}\r\n.menu-btn svg{width:16px;height:16px;display:block}\r\n.menu-btn .ico-close{display:none}\r\n.shell.nav-open .menu-btn .ico-menu{display:none}\r\n.shell.nav-open .menu-btn .ico-close{display:block}\r\n.nav-backdrop{display:none}\r\n.side-logo{\r\n  width:32px;height:32px;border-radius:8px;flex-shrink:0;\r\n  background:var(--panel-2);border:1px solid var(--line);\r\n  color:var(--ink);display:grid;place-items:center;padding:6px;\r\n}\r\n.side-logo svg{width:100%;height:100%}\r\n.side-brand strong{\r\n  font-size:.88rem;font-weight:600;letter-spacing:-.02em;\r\n}\r\n.side-nav{flex:1;overflow:auto;padding:2px 8px 12px;scrollbar-width:thin;scrollbar-color:color-mix(in srgb,var(--ink) 16%,transparent) transparent}\r\n.side-nav::-webkit-scrollbar{width:6px}\r\n.side-nav::-webkit-scrollbar-track{background:transparent}\r\n.side-nav::-webkit-scrollbar-thumb{\r\n  background:color-mix(in srgb,var(--ink) 16%,transparent);border-radius:99px;\r\n}\r\n.side-sec{\r\n  margin:12px 0 4px;padding:0 10px;\r\n  font-size:.72rem;font-weight:600;letter-spacing:-.01em;color:var(--dim);\r\n}\r\n.side-sec:first-child{margin-top:4px}\r\n.side-item{\r\n  position:relative;display:flex;align-items:center;gap:10px;width:100%;\r\n  padding:7px 10px;border-radius:10px;text-align:left;color:var(--muted);\r\n  border:1px solid transparent;\r\n  transition:color .12s,background .12s,border-color .12s;\r\n}\r\n.side-item:hover{color:var(--ink);background:var(--panel-2)}\r\n.side-item[aria-current=\"true\"]{\r\n  color:var(--accent);background:var(--sel-bg);border-color:color-mix(in srgb,var(--accent) 28%,var(--line));\r\n}\r\n.side-item .si{width:18px;height:18px;flex-shrink:0;color:inherit}\r\n.side-item .si svg{width:100%;height:100%}\r\n.side-item .sl{font-size:.88rem;font-weight:500;line-height:1.3;min-width:0}\r\n.side-item .tour-mark{\r\n  margin-left:auto;width:8px;height:8px;border-radius:50%;flex-shrink:0;\r\n  background:var(--accent);opacity:0;box-shadow:0 0 0 0 color-mix(in srgb,var(--accent) 45%,transparent);\r\n  transition:opacity .15s;\r\n}\r\n.side-item[aria-current=\"true\"][data-tour=\"playing\"] .tour-mark{\r\n  opacity:1;animation:tour-pulse 1.4s ease-out infinite;\r\n}\r\n.side-item[aria-current=\"true\"][data-tour=\"paused\"] .tour-mark{opacity:.55;background:var(--amber)}\r\n.side-item .tour-bar{\r\n  position:absolute;left:12px;right:12px;bottom:3px;height:2px;border-radius:999px;\r\n  background:var(--accent-soft);overflow:hidden;opacity:0;pointer-events:none;\r\n}\r\n.side-item[aria-current=\"true\"][data-tour=\"playing\"] .tour-bar{opacity:1}\r\n.side-item .tour-bar > i{\r\n  display:block;height:100%;width:0;border-radius:inherit;background:var(--accent);\r\n}\r\n.side-item[aria-current=\"true\"][data-tour=\"playing\"][data-media=\"image\"] .tour-bar > i{\r\n  animation:tour-fill var(--tour-ms,4000ms) linear forwards;\r\n}\r\n.side-item[aria-current=\"true\"][data-tour=\"playing\"][data-media=\"video\"] .tour-bar > i{\r\n  width:40%;animation:tour-indeterminate 1.2s ease-in-out infinite;\r\n}\r\n@keyframes tour-pulse{\r\n  0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--accent) 45%,transparent)}\r\n  70%{box-shadow:0 0 0 8px color-mix(in srgb,var(--accent) 0%,transparent)}\r\n  100%{box-shadow:0 0 0 0 color-mix(in srgb,var(--accent) 0%,transparent)}\r\n}\r\n@keyframes tour-fill{from{width:0}to{width:100%}}\r\n@keyframes tour-indeterminate{\r\n  0%{transform:translateX(-120%)}\r\n  100%{transform:translateX(280%)}\r\n}\r\n.side-foot{padding:10px;border-top:1px solid var(--line);display:flex;justify-content:center;gap:8px}\r\n.theme-btn,.layout-btn{\r\n  width:34px;height:34px;border-radius:10px;display:grid;place-items:center;\r\n  border:1px solid var(--line);background:var(--panel-2);color:var(--muted);\r\n  transition:border-color .12s,color .12s,background .12s;\r\n}\r\n.theme-btn:hover,.layout-btn:hover{color:var(--accent);border-color:color-mix(in srgb,var(--accent) 40%,var(--line))}\r\n.theme-btn .sun{display:none}\r\n.tv-explore[data-theme=\"light\"] .theme-btn .moon{display:none}\r\n.tv-explore[data-theme=\"light\"] .theme-btn .sun{display:block}\r\n.layout-btn svg{width:16px;height:16px;display:block}\r\n.layout-btn .ico-classic{display:none}\r\n.layout-btn[aria-pressed=\"true\"]{\r\n  color:var(--accent);background:var(--sel-bg);\r\n  border-color:color-mix(in srgb,var(--accent) 28%,var(--line));\r\n}\r\n.tv-explore.tv-stack .layout-btn .ico-scroll{display:none}\r\n.tv-explore.tv-stack .layout-btn .ico-classic{display:block}\r\n\r\n/* ── main stage ── */\r\n.main{min-width:0;display:flex;flex-direction:column;min-height:0;gap:10px}\r\n.stage{\r\n  flex:1;min-height:0;display:flex;flex-direction:column;overflow:hidden;\r\n  border-radius:var(--radius);border:1px solid var(--line);\r\n  background:var(--panel);box-shadow:var(--shadow);\r\n  /* Keep the 1px frame outside overflow clipping */\r\n  padding:1px;\r\n  /* Vertical page scroll