em;line-height:1.2;\r\n}\r\n.intro-body h2{\r\n  margin:16px 0 6px;font-size:1rem;font-weight:600;letter-spacing:-.02em;\r\n}\r\n.intro-body h3{margin:12px 0 4px;font-size:.9rem;font-weight:600}\r\n.intro-body p,.intro-body li{color:var(--muted);font-size:.84rem;line-height:1.5}\r\n.intro-body p{margin:0 0 10px}\r\n.intro-body ul,.intro-body ol{margin:0 0 12px;padding-left:1.2em}\r\n.intro-body li{margin:3px 0}\r\n.intro-body a{color:var(--accent);text-decoration:underline;text-underline-offset:2px}\r\n.intro-body code{font-size:.84em}\r\n.intro-body img,.intro-body video{\r\n  border-radius:10px;margin:8px 0 12px;border:1px solid var(--line);max-width:100%;\r\n}\r\n.intro-card .intro-body{background:var(--panel)}\r\n.intro-page{display:flex;flex-direction:column;min-height:0}\r\n.stage:not(.is-stack) .stage-body:has(.intro-page){display:flex;flex-direction:column;min-height:0}\r\n.stage:not(.is-stack) .intro-page{flex:1 1 auto;height:auto;min-height:0;overflow:auto}\r\n.intro-jumps{\r\n  display:grid;\r\n  grid-template-columns:repeat(2,minmax(0,1fr));\r\n  gap:10px;\r\n  padding:4px 12px 16px;\r\n}\r\n@media(min-width:720px){\r\n  .intro-jumps{grid-template-columns:repeat(3,minmax(0,1fr))}\r\n}\r\n@media(min-width:1100px){\r\n  .intro-jumps{grid-template-columns:repeat(4,minmax(0,1fr))}\r\n}\r\n.intro-jump{\r\n  position:relative;display:block;width:100%;\r\n  min-height:148px;aspect-ratio:16/10;\r\n  padding:0;border-radius:12px;overflow:hidden;\r\n  border:1px solid var(--line);background:var(--media);\r\n  text-align:left;color:#fff;\r\n}\r\n.intro-jump img,.intro-jump video{\r\n  width:100%;height:100%;object-fit:cover;display:block;\r\n}\r\n.intro-jump-fallback{\r\n  display:grid;place-items:center;width:100%;height:100%;\r\n  color:var(--muted);background:var(--panel-2);\r\n}\r\n.intro-jump-fallback svg{width:40px;height:40px}\r\n.intro-jump-label{\r\n  position:absolute;left:0;right:0;bottom:0;\r\n  padding:36px 12px 10px;\r\n  background:linear-gradient(to